{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet, noimageindex"
        }
      ]
    }
  ],
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/skin-cancer-check/",
      "permanent": false
    }
  ]
}
